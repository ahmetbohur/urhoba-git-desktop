{
  "name": "urhoba-git-desktop",
  "productName": "Urhoba Git Desktop",
  "version": "1.0.0",
  "description": "Depolarını tek pencereden takip eden modern bir masaüstü Git istemcisi.",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "electron-forge package && playwright test",
    "test:all": "vitest run && npm run test:e2e",
    "qa": "URHOBA_QA=1 playwright test qa",
    "screenshots": "URHOBA_SCREENSHOTS=1 playwright test screenshot",
    "test:ai": "URHOBA_OLLAMA=1 playwright test ai-check"
  },
  "keywords": [
    "git",
    "electron",
    "desktop",
    "github"
  ],
  "author": {
    "name": "Urhoba",
    "url": "https://urhoba.com"
  },
  "homepage": "https://urhoba.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ahmetbohur/urhoba-git-desktop"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "44.0.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-virtual": "^3.14.10",
    "chokidar": "^5.0.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dugite": "^3.2.3",
    "electron-squirrel-startup": "^1.0.1",
    "lucide-react": "^1.37.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "update-electron-app": "^3.3.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  }
}
