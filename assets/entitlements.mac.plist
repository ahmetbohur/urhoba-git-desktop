<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Electron'un V8 motoru çalışma anında makine kodu üretiyor; sertleştirilmiş
    çalışma zamanı bunu varsayılan olarak engelliyor.
  -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!--
    Uygulama kendi taşıdığı git ikilisini çalıştırıyor. Kütüphane doğrulaması
    açıkken, farklı bir Team ID ile imzalanmış ya da imzasız bir kütüphane
    yüklenemiyor ve gömülü git'in bağımlılıkları buna takılıyor.
  -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!--
    Git alt süreçlerine ortam değişkeni geçiriyoruz (GIT_SSH_COMMAND,
    GIT_CONFIG_SYSTEM ve benzeri). Sertleştirilmiş çalışma zamanı bu izin
    olmadan bazılarını temizliyor.
  -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>

  <!-- Depolar kullanıcının kendi klasörlerinde; dosya erişimi gerekiyor. -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <!-- SSH anahtarları ve uzak sunucular için ağ erişimi. -->
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
